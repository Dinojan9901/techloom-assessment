# --- Required -------------------------------------------------------------
# A replica set is required for multi-document transactions. MongoDB Atlas
# (including the free M0 tier) is always a replica set, so the hosted URI works
# as-is. A bare local `mongod` is not, and the app falls back to atomic
# per-document updates plus compensating rollback.
MONGODB_URI=mongodb://127.0.0.1:27017/techloom_pos
PORT=4001

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=http://localhost:3001

# --- Reservation behaviour ------------------------------------------------
# The assessment asks for 5 minutes. Lower it to watch expiry happen live.
RESERVATION_TTL_MINUTES=5
# How often the background sweeper looks for lapsed reservations.
SWEEPER_INTERVAL_MS=15000

# --- Mock payment gateway -------------------------------------------------
# How long a simulated "timeout" hangs before giving up.
PAYMENT_TIMEOUT_MS=1500
# Weights used when a payment is requested without an explicit outcome.
PAYMENT_WEIGHT_SUCCESS=70
PAYMENT_WEIGHT_FAILURE=20
PAYMENT_WEIGHT_TIMEOUT=10
